# Supabase > Project Settings > API: URL e chave pública anon (ou publishable).
# Nunca use service_role ou secret key em variáveis NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL final do site, sem barra no final. Para teste local:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
